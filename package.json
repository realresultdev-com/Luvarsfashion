{
  "name": "luvarsfashion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:wrangler\"",
    "dev:wrangler": "wrangler pages dev --d1 DB=20cbffcc-c554-4004-9483-bc4a2989d59f --r2 BUCKET=buddymatters --compatibility-date=2024-09-01 --proxy 5175",
    "dev:dist": "npm run build && wrangler pages dev dist --d1 DB --r2 BUCKET=buddymatters --compatibility-date=2024-09-01",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "d1:init": "node scripts/init-d1.js",
    "d1:init:remote": "node scripts/init-d1.js --remote",
    "d1:clear": "wrangler d1 execute DB --local --file=./migrations/0016_clear_fake_products.sql",
    "d1:clear:remote": "wrangler d1 execute DB --remote --file=./migrations/0016_clear_fake_products.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=luvarsfashion",
    "deploy:dev": "npm run build && wrangler pages deploy dist --project-name=luvarsfashion --branch=dev",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name=luvarsfashion --branch=main",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build:apk": "export JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" && (cd android && ./gradlew assembleDebug)",
    "cap:build:aab": "export JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" && (cd android && ./gradlew bundleRelease)"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.5.11",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "hono": "^4.5.8",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
